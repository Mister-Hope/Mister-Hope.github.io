{
  "name": "blog",
  "version": "1.0.0",
  "description": "个人博客",
  "keywords": [
    "personal-blog",
    "vuepress"
  ],
  "license": "MIT",
  "author": "Mr.Hope",
  "type": "module",
  "scripts": {
    "build": "vuepress-vite build src",
    "build:debug": "cross-env DEBUG=vuepress* vuepress-vite build src",
    "dev": "vuepress-vite dev src",
    "dev:clean": "vuepress-vite dev src --clean-cache",
    "dev:debug": "cross-env DEBUG=vuepress* vuepress-vite dev src",
    "lint": "oxfmt",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "test": "echo \"Warning: no test specified\" && exit 0"
  },
  "dependencies": {
    "@mathjax/src": "4.1.3",
    "@vuepress/bundler-vite": "2.0.0-rc.32",
    "@vuepress/plugin-append-date": "2.0.0-rc.139",
    "@vuepress/plugin-cache": "2.0.0-rc.138",
    "@vuepress/plugin-docsearch": "2.0.0-rc.139",
    "@vuepress/plugin-feed": "2.0.0-rc.139",
    "@vuepress/plugin-revealjs": "2.0.0-rc.139",
    "@waline/client": "3.16.2",
    "flowchart.ts": "4.0.0",
    "mermaid": "12.3.0",
    "reveal.js": "6.0.2",
    "sass-embedded": "1.108.2",
    "sass-loader": "17.1.1",
    "vue": "3.5.46",
    "vuepress": "2.0.0-rc.32",
    "vuepress-theme-hope": "2.0.0-rc.111"
  },
  "devDependencies": {
    "cross-env": "10.1.0",
    "markdownlint-cli2": "0.24.2",
    "oxc-config-hope": "0.3.15",
    "oxfmt": "0.79.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "error"
    }
  }
}
